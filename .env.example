# Copy this file to .env and paste the values from Supabase → Project Settings → API.
# The anon key is safe to ship in the browser. Row Level Security protects the data.
# Leave these blank (or delete .env) to open the setup screen and the local demo.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Set to true only after you enable the Google provider in Supabase Auth.
# When this is missing or false, the Google button stays disabled instead of failing.
VITE_SUPABASE_GOOGLE_ENABLED=false
